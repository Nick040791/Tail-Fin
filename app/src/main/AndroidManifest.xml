<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="com.tailfin.permission.READ_ENV_VAULT"
        android:label="Read TailFin .env Credentials"
        android:description="@string/perm_read_env_vault"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="com.tailfin.permission.READ_ENV_VAULT" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Requested only when the user explicitly enables local contact search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Ordinary permission for the opt-in Lab status-bar API path; no accessibility access. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Hidden profiles are accessible only while TailFin holds the default HOME role. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Actual widget binding is still granted by the user through Android's bind UI. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <!-- Some OEM clocks, including Samsung's, protect SHOW_ALARMS with this permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="org.breezyweather" />
        <package android:name="com.tailscale.ipn" />
        <package android:name="com.stablyai.orca" />
        <package android:name="com.stably.orca.mobile" />
        <package android:name="com.nicholas.fin" />
        <package android:name="com.scariflabs.horus" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.fdroid.fdroid" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.rk.taskmanager" />
        <package android:name="com.fsck.k9" />
        <package android:name="org.fossify.filemanager" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TailFin"
        tools:targetApi="33">

        <!-- Hardware-Backed Encrypted .env Credential Vault ContentProvider -->
        <provider
            android:name="com.tailfin.launcher.security.EnvVaultContentProvider"
            android:authorities="com.tailfin.launcher.env"
            android:exported="true"
            android:readPermission="com.tailfin.permission.READ_ENV_VAULT" />

        <!-- Shizuku Binder Provider for Privileged Operations -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Background Memory Optimizer Service -->
        <service
            android:name="com.tailfin.launcher.memory.MemoryOptimizerService"
            android:exported="false" />

        <!-- Bundled FOSS APK Provisioning Status Receiver -->
        <receiver
            android:name="com.tailfin.launcher.ecosystem.ApkInstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tailfin.launcher.action.APK_INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- The official Breezy notifier requires an exported receiver and defines no
             sender permission. Payloads are ignored; signals only coalesce a read of
             the permission-protected, package-verified provider while enabled. -->
        <receiver
            android:name="com.galaxyrio.gracelauncher.platform.BreezyWeatherUpdateReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.breezyweather.ACTION_UPDATE_NOTIFIER" />
            </intent-filter>
        </receiver>
        <!-- Explicit, user-authorized lock-screen and system-panel actions only. -->
        <service
            android:name="com.galaxyrio.gracelauncher.platform.GraceAccessibilityService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/grace_accessibility_service" />
        </service>
        <!-- System-managed binding for app notification previews and media sessions. -->
        <service
            android:name="com.galaxyrio.gracelauncher.data.media.MediaNotificationListener"
            android:label="@string/media_service_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.galaxyrio.gracelauncher.MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TailFin.Home"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.galaxyrio.gracelauncher.PinItemActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TailFin.Settings">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.galaxyrio.gracelauncher.WidgetSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.TailFin.Settings" />
        <activity
            android:name="com.galaxyrio.gracelauncher.SettingsActivity"
            android:exported="true"
            android:label="@string/grace_settings"
            android:theme="@style/Theme.TailFin.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
