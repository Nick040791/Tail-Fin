<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TailFin" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.TailFin.Home" parent="Theme.TailFin" />

    <style name="Theme.TailFin.Settings" parent="Theme.TailFin">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <!-- Backwards-compatible aliases for existing activity declarations -->
    <style name="Theme.GraceLauncher" parent="Theme.TailFin" />
    <style name="Theme.GraceLauncher.Home" parent="Theme.TailFin.Home" />
    <style name="Theme.GraceLauncher.Settings" parent="Theme.TailFin.Settings" />
</resources>
