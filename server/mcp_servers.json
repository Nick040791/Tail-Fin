{
  "mcpServers": {
    "fin-workspace": {
      "description": "Fin built-in MCP server for PC system telemetry & local Documents workspace",
      "command": "python3",
      "args": ["server/mcp_bridge/workspace_mcp_server.py"],
      "enabled": true,
      "require_approval": ["workspace_write_file"]
    },
    "filesystem": {
      "description": "Node.js @modelcontextprotocol/server-filesystem for local Documents",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/mrnicholas/Documents"],
      "enabled": false,
      "require_approval": ["write_file", "edit_file", "move_file"]
    },
    "github": {
      "description": "GitHub repository and PR management MCP server",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": false,
      "require_approval": ["create_pull_request", "push_files", "create_issue"]
    }
  }
}
